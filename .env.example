# Compose는 .env를 읽지만 Spring Boot는 이 파일을 자동으로 읽지 않습니다.
# README에 따라 DB_NAME / DB_USER / DB_PASSWORD 등을 실행 프로세스 환경변수로도 설정하세요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mini_mes
DB_USER=mes_app

# 로컬 .env에서만 각각 다른 비밀번호를 입력하세요. 빈 값은 Compose에서 거부합니다.
# 특수문자가 포함되면 Compose .env 문법에 맞게 작은따옴표로 감싸세요.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 인증 사용자가 아닌 개발용 시스템 작성자. 누락·공백이면 품목 등록을 거부합니다.
# VS Code envFile은 이 파일을 직접 읽지 않으므로 로컬 .env에 설정하세요.
MES_ACTOR_ID=LOCAL_DEV
